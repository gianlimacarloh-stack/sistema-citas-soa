    {
      "name": "SOAP - Clientes (8081)",
      "item": [
        {
          "name": "validarCliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:cli=\"http://idat.edu.pe/clientes\">\n   <soapenv:Header/>\n   <soapenv:Body>\n      <cli:validarClienteRequest>\n         <cli:dni>70123456</cli:dni>\n      </cli:validarClienteRequest>\n   </soapenv:Body>\n</soapenv:Envelope>\n",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8081/ws",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "ws"
              ]
            }
          }
        },
