{
  "info": {
    "name": "Sistema de citas SOA - M&A Electric",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas del servicio REST de Citas y de los servicios SOAP de Clientes y Tecnicos. Use fechas futuras (lunes a sabado)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "REST - Citas (8080)",
      "item": [
        {
          "name": "1. Listar tipos de servicio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servicios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servicios"
              ]
            }
          }
        },
        {
          "name": "2. Ver horarios libres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/servicios/MANTENIMIENTO/disponibilidad?fecha=2026-11-20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "servicios",
                "MANTENIMIENTO",
                "disponibilidad"
              ],
              "query": [
                {
                  "key": "fecha",
                  "value": "2026-11-20"
                }
              ]
            }
          }
        },
        {
          "name": "3. Reservar cita - cliente registrado (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/citas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "citas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"70123456\",\n  \"tipoServicio\": \"MANTENIMIENTO\",\n  \"fecha\": \"2026-11-20\",\n  \"hora\": \"10:00\",\n  \"descripcion\": \"Mantenimiento de grupo electrogeno Hyundai 10 kVA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
